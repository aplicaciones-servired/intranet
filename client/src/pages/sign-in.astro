---
import "../styles/global.css";
import LoginForm from "../components/LoginForm";

const user = (Astro.locals as any).user;

// Validar que el redirect sea interno (previene open redirect)
const rawRedirect = (Astro.url.searchParams.get("redirect_url") ?? "/admin/Home").trim();
const safeRedirect =
  rawRedirect.startsWith("/") &&
  !rawRedirect.startsWith("//") &&
  !rawRedirect.includes("\\") &&
  !/^[a-zA-Z][a-zA-Z0-9+.-]*:/.test(rawRedirect)
    ? rawRedirect
    : "/admin/Home";

// Si ya tiene sesión, redirigir directamente
if (user) {
  return Astro.redirect(safeRedirect);
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/intranet.png" />
    <title>Iniciar sesión — Intranet</title>
  </head>
  <body>
    <LoginForm redirectUrl={safeRedirect} client:load />
  </body>
</html>
