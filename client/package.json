{
  "name": "intranet",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "dev:network": "astro dev --host 0.0.0.0",
    "build": "tsc --skipLibCheck --noEmit && astro build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs --host 0.0.0.0 --port 4321"
  },
  "dependencies": {
    "@astrojs/node": "^9.5.2",
    "@astrojs/react": "^4.4.2",
    "@chakra-ui/react": "^3.31.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.0",
    "axios": "^1.13.5",
    "framer-motion": "^12.29.2",
    "jose": "^6.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "tailwindcss": "^4.1.18"
  }
}
